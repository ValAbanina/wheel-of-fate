{
  "name": "wheel-of-fate",
  "private": true,
  "version": "1.0.0",
  "description": "Madame Nocturne's Wheel of Fate \u2014 a Halloween spin-the-wheel game with spoken fortunes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audio": "node scripts/generate-audio.mjs",
    "test": "node --experimental-strip-types scripts/simulate-odds.ts",
    "fonts:cjk": "python3 scripts/subset-cjk-fonts.py",
    "audio:normalize": "node scripts/normalize-audio.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/cormorant-sc": "5.3.0",
    "gsap": "3.15.0",
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

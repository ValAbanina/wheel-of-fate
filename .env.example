# Copy this file to .env and fill in your own values. .env is never committed.
ELEVENLABS_API_KEY=
# The voice you created for Madame Nocturne (Voice Design or Voice Library → copy the Voice ID)
ELEVENLABS_VOICE_ID=aiMXrxPyvsvYT5glz1Kx
# Optional: a model that understands [audio tags]. Run `npm run audio -- --list-models` to see yours.
ELEVENLABS_MODEL_ID=eleven_v3
# Optional: a different voice for Russian or Mandarin (otherwise the main voice speaks all languages)
ELEVENLABS_VOICE_ID_RU=
ELEVENLABS_VOICE_ID_ZH=
